pragma solidity 0.8.28;
import {ERC20} from '@openzeppelin/contracts/token/ERC20/ERC20.sol';
import {PaymentRouter} from '../src/PaymentRouter.sol';
import {SubscriptionManager} from '../src/SubscriptionManager.sol';
import {RewardsVault} from '../src/RewardsVault.sol';
import {PartnershipRegistry} from '../src/PartnershipRegistry.sol';
import {OffersRedemption} from '../src/OffersRedemption.sol';
import {Quote} from '../src/Types.sol';
interface Vm {function addr(uint256) external returns(address);function sign(uint256,bytes32) external returns(uint8,bytes32,bytes32);function prank(address) external;function startPrank(address) external;function stopPrank() external;function expectRevert() external;function warp(uint256) external;function chainId(uint256) external;}
contract MockToken is ERC20 {constructor() ERC20('Local test token','LOCAL'){} function mint(address to,uint256 amount) external {_mint(to,amount);}}
contract ProtocolTest {
 Vm constant vm=Vm(address(uint160(uint256(keccak256('hevm cheat code')))));
 MockToken token; PaymentRouter router; SubscriptionManager manager; RewardsVault vault; address merchant; address customer; address partner;
 function setUp() public {vm.chainId(31611);merchant=vm.addr(1);customer=vm.addr(2);partner=vm.addr(3);token=new MockToken();router=new PaymentRouter(address(token));manager=SubscriptionManager(router.subscriptionManager());vault=new RewardsVault(address(token),address(router));token.mint(customer,1000 ether);token.mint(merchant,1000 ether);vm.prank(customer);token.approve(address(router),type(uint256).max);}
 function quote() internal view returns(Quote memory){return Quote(bytes32(uint256(1)),merchant,address(token),20 ether,partner,300,500,block.timestamp+1 days);}
 function sig(bytes32 hash) internal returns(bytes memory){(uint8 v,bytes32 r,bytes32 s)=vm.sign(1,hash);return abi.encodePacked(r,s,v);}
 function pay(Quote memory q) internal returns(bytes32){bytes memory signature=sig(router.hashQuote(q));vm.prank(customer);return router.pay(q,signature);}
 function testSplitReplayAndRefund() public {Quote memory q=quote();bytes32 hash=pay(q);require(token.balanceOf(partner)==0.6 ether);require(token.balanceOf(customer)==981 ether);require(token.balanceOf(merchant)==1018.4 ether);require(token.balanceOf(address(router))==0);bytes memory signature=sig(router.hashQuote(q));vm.expectRevert();vm.prank(customer);router.pay(q,signature);vm.startPrank(merchant);token.approve(address(router),20 ether);router.refund(hash,20 ether);vm.expectRevert();router.refund(hash,1);vm.stopPrank();require(token.balanceOf(customer)==1001 ether);}
 function testTamperedExpiredWrongTokenWrongSignerAndCancel() public {Quote memory q=quote();bytes memory signature=sig(router.hashQuote(q));q.amount++;vm.expectRevert();vm.prank(customer);router.pay(q,signature);q=quote();q.token=address(0);signature=sig(router.hashQuote(q));vm.expectRevert();vm.prank(customer);router.pay(q,signature);q=quote();signature=sig(router.hashQuote(q));vm.warp(q.deadline);vm.expectRevert();vm.prank(customer);router.pay(q,signature);q=quote();vm.prank(merchant);router.cancel(q.orderId);signature=sig(router.hashQuote(q));vm.expectRevert();vm.prank(customer);router.pay(q,signature);}
 function testFuzzConservation(uint128 raw,uint16 rate,uint16 cash) public {uint256 amount=uint256(raw)+1;uint16 referral=uint16(uint256(rate)%10001);uint16 cashback=uint16(uint256(cash)%(10001-referral));token.mint(customer,amount);Quote memory q=Quote(bytes32(uint256(7)),merchant,address(token),amount,referral==0?address(0):partner,referral,cashback,block.timestamp+1 days);uint256 beforeMerchant=token.balanceOf(merchant);uint256 beforeCustomer=token.balanceOf(customer);uint256 beforePartner=token.balanceOf(partner);pay(q);uint256 seller=token.balanceOf(merchant)-beforeMerchant;uint256 partnerAmount=token.balanceOf(partner)-beforePartner;uint256 cashbackAmount=token.balanceOf(customer)+amount-beforeCustomer;require(seller+partnerAmount+cashbackAmount==amount);require(token.balanceOf(address(router))==0);}
 function testAtomicAllowanceFailure() public {Quote memory q=quote();vm.prank(customer);token.approve(address(router),1);bytes memory signature=sig(router.hashQuote(q));vm.expectRevert();vm.prank(customer);router.pay(q,signature);require(!router.consumed(merchant,q.orderId));require(token.balanceOf(partner)==0);}
 function testRewardBudgetAndIsolation() public {vm.startPrank(merchant);bytes32 id=vault.create(bytes32(uint256(1)),10 ether,20 ether,block.timestamp,block.timestamp+1 days);token.approve(address(vault),10 ether);vault.fund(id,10 ether);vm.stopPrank();bytes32 hash=pay(quote());vm.prank(customer);vault.claim(id,hash);vm.expectRevert();vm.prank(customer);vault.claim(id,hash);Quote memory q=quote();q.orderId=bytes32(uint256(2));bytes32 second=pay(q);vm.expectRevert();vm.prank(customer);vault.claim(id,second);vm.expectRevert();vm.prank(partner);vault.reclaim(id);}
 function testSubscriptionBoundsCancelExpiryAndNoDoubleCharge() public {SubscriptionManager.Plan memory p=SubscriptionManager.Plan(merchant,partner,10 ether,300,500,1 days,block.timestamp,block.timestamp+7 days,2,bytes32(uint256(1)));bytes memory signature=sig(manager.hashPlan(p));vm.prank(customer);bytes32 id=manager.subscribe(p,signature);manager.charge(id);vm.expectRevert();manager.charge(id);vm.warp(block.timestamp+1 days);manager.charge(id);vm.warp(block.timestamp+1 days);vm.expectRevert();manager.charge(id);p.nonce=bytes32(uint256(2));signature=sig(manager.hashPlan(p));vm.prank(customer);bytes32 cancelled=manager.subscribe(p,signature);vm.prank(customer);manager.cancel(cancelled);vm.expectRevert();manager.charge(cancelled);p.nonce=bytes32(uint256(3));signature=sig(manager.hashPlan(p));vm.prank(customer);bytes32 expired=manager.subscribe(p,signature);vm.warp(p.expiresAt);vm.expectRevert();manager.charge(expired);}
 function testUnauthorizedRecurringCall() public {vm.expectRevert();router.settleRecurring(quote(),customer);}
 function testRegistryAndOffers() public {PartnershipRegistry registry=new PartnershipRegistry();vm.prank(merchant);bytes32 id=registry.approve(bytes32(uint256(1)),partner,300,block.timestamp+1 days);vm.expectRevert();vm.prank(customer);registry.revoke(id);vm.prank(merchant);registry.revoke(id);OffersRedemption offers=new OffersRedemption();OffersRedemption.Offer memory offer=OffersRedemption.Offer(bytes32(uint256(1)),merchant,customer,1 ether,block.timestamp+1 days);bytes memory signature=sig(offers.hashOffer(offer));vm.expectRevert();vm.prank(partner);offers.redeem(offer,signature);vm.prank(customer);offers.redeem(offer,signature);vm.expectRevert();vm.prank(customer);offers.redeem(offer,signature);}
}
