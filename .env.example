DATABASE_URL=postgres://mezoloop:mezoloop@localhost:5432/mezoloop
PUBLIC_APP_URL=http://localhost:3000
PORT=3001
HOST=127.0.0.1
MEZO_RPC_HTTP=https://rpc.test.mezo.org
# Required to create quotes. Set only after deploying and verifying the router.
PAYMENT_ROUTER_ADDRESS=
NODE_ENV=development

# Optional contract modules (set after deployment)
REWARDS_VAULT_ADDRESS=
PARTNERSHIP_REGISTRY_ADDRESS=
OFFERS_ADDRESS=
# First block containing the deployed contracts
INDEXER_START_BLOCK=0
CONFIRMATIONS=3
FINALITY_CONFIRMATIONS=12
# Optional: MEZO_RPC_FALLBACK
# Set WORKER_PRIVATE_KEY and WEBHOOK_ENCRYPTION_KEY through your secret manager.
