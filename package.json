{
  "name": "mezoloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/db/migrate.ts",
    "chain:smoke": "node --env-file-if-exists=.env --import tsx packages/chain/smoke.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/server.ts",
    "contracts:build": "forge build --root contracts && tsx scripts/generate-abi.ts",
    "contracts:test": "forge test --root contracts -vv",
    "web:dev": "node scripts/web.mjs dev --hostname 127.0.0.1",
    "web:build": "node scripts/web.mjs build",
    "web:start": "node scripts/web.mjs start --hostname 127.0.0.1",
    "web:typecheck": "tsc --project apps/web/tsconfig.json --noEmit",
    "web:test": "playwright test",
    "test:payments": "tsx --test tests/payment-flow.integration.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@openzeppelin/contracts": "5.0.2",
    "@zxing/browser": "^0.2.1",
    "fastify": "^5.0.0",
    "next": "^16.4.2",
    "pg": "^8.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "tsx": "^4.0.0",
    "viem": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.0.0"
  }
}
